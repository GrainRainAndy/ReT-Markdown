{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM"], "types": ["node"], "noEmit": true
  },
  "include": ["editor/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
